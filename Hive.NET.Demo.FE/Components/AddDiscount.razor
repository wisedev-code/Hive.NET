@using Hive.NET.Demo.Api.RequestModel
@inject HiveApiClient HiveApiClient

<EditForm Model="@model" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="p-2">
        <h3>Add discount</h3>
    </div>
    <div class="form-group p-2">
        <label>Can have discount:</label>
        <input class="form-check-input" type="checkbox" id="number" @bind="model.CanHaveDiscount"/>
    </div>
    <div class="form-group p-2">
        <label>Discount percentage:</label>
        <InputNumber class="form-control" id="product" @bind-Value="model.Discount"/>
    </div>
    <div class="p-2">
        <button class="btn btn-primary" type="submit">Add</button>
    </div>
</EditForm>

@code {
    private CustomerDiscountRequest model = new CustomerDiscountRequest();

    [Parameter] public Guid? CustomerId { get; set; }
    [Parameter] public EventCallback<CustomerDiscountRequest> OnAdd { get; set; }

    protected override async Task OnParametersSetAsync()
    {

    }

    private async Task HandleValidSubmit()
    {
        await OnAdd.InvokeAsync(model);
        await HiveApiClient.ApplyDiscount(CustomerId ?? throw new Exception("Invalid customer id"), model);
        model = new CustomerDiscountRequest();
    }

}
